# Copy this file to .env. Never commit .env.
# By default the agents run through Claude Code on this PC, on your Claude plan (PLAN mode): leave the key empty.
# Only if you want a separate pay-per-use bill instead, put an API key here (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=

# Optional
# WARROOM_PORT=4747
# WARROOM_HOST=127.0.0.1          # keep 127.0.0.1 unless you add WARROOM_TOKEN
# WARROOM_TOKEN=                  # set a long random string to lock the dashboard (open once with /?token=...)
# WARROOM_WORKSPACE=..            # folder the agents work in (default: the studio repo)
# WARROOM_SLOTS=6                 # agent slots: Haiku 0.5, Sonnet 1, Opus 2 (so 5 Sonnet agents, or 1 Opus + 4 Sonnet)
# WARROOM_WINDOW_USD=25           # soft cap: pause NEW work when the last 5 hours used this much (API-equivalent $)
# WARROOM_DEEP_MODEL=claude-opus-5-5   # model for orders sent with "Deep" ticked
# WARROOM_BACKEND=plan            # plan | api | demo (default: api if a key is set, else plan if Claude Code is installed)
# WARROOM_TASK_BUDGET_USD=3       # hard spend cap per task
# WARROOM_MODEL=claude-opus-5-5   # default model for agents without one in their .md
