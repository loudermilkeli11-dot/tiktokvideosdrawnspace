# Copy this file to .env and fill in your key. Never commit .env.
# Create a key at https://console.anthropic.com/settings/keys (usage is billed to that account).
ANTHROPIC_API_KEY=

# Optional
# WARROOM_PORT=4747
# WARROOM_HOST=127.0.0.1          # keep 127.0.0.1 unless you add WARROOM_TOKEN
# WARROOM_TOKEN=                  # set a long random string to lock the dashboard (open once with /?token=...)
# WARROOM_WORKSPACE=..            # folder the agents work in (default: the studio repo)
# WARROOM_MAX_PARALLEL=3          # agents running at once
# WARROOM_TASK_BUDGET_USD=3       # hard spend cap per task
# WARROOM_MODEL=claude-opus-5-5   # default model for agents without one in their .md
